# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Xcode / iOS (user-specific)
**/xcuserdata/
*.xcuserstate

# Claude Code — local agent worktree mirrors (not source of truth; large)
.claude/worktrees/

# Manual git worktrees (registered via `git worktree add`; not source of truth; large)
.worktrees/

# Claude Code — machine-local permission overrides
.claude/settings.local.json
.claude/launch.json

# Local generated artifacts
/tmp/

# Solar permit audit downloads (local only)
/scripts/solar-permits/data/
