# Public website roof estimate funnel
#
# Enable in Vercel / local:
#   PUBLIC_ROOF_ESTIMATE_ENABLED=true
#   PUBLIC_ESTIMATE_TOKEN_SECRET=<dedicated random ≥32 chars — NOT webhook/service-role>
#   TURNSTILE_SECRET_KEY=<cloudflare turnstile secret>
# Optional:
#   PUBLIC_ESTIMATE_PRICE_PER_SQUARE=413
#   PUBLIC_ESTIMATE_RANGE_BAND=0.15
#   PUBLIC_ESTIMATE_ORG_ID=9089d4ad-f46c-405b-9798-6751d45a7051  # required when funnel enabled
#   PUBLIC_ESTIMATE_TURNSTILE_ON_PREVIEW=false   # defaults ON when funnel enabled
#
# Website (.env):
#   VITE_CRM_PUBLIC_ESTIMATE_URL=https://arx-internal-crm.vercel.app
#   VITE_TURNSTILE_SITE_KEY=...
