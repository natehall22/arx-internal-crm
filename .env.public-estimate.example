# Public website roof estimate funnel
#
# Enable in Vercel / local:
#   PUBLIC_ROOF_ESTIMATE_ENABLED=true
#   PUBLIC_ESTIMATE_TOKEN_SECRET=<dedicated random ≥32 chars — NOT webhook/service-role>
#   TURNSTILE_SECRET_KEY=<cloudflare turnstile secret>
#   TURNSTILE_SITE_KEY=<cloudflare turnstile site key>   # public; served by GET /api/public/estimate/config
# Optional:
#   PUBLIC_ESTIMATE_PRICE_PER_SQUARE=413
#   PUBLIC_ESTIMATE_FALLBACK_PRICE_PER_SQUARE=530   # unreliable auto-measure with squares_mid > 0, facet_count < 10
#   PUBLIC_ESTIMATE_COMPLEX_FALLBACK_PRICE_PER_SQUARE=550   # unreliable with squares_mid > 0 and facet_count ≥ 10
#   PUBLIC_ESTIMATE_RANGE_BAND=0.15
#   PUBLIC_ESTIMATE_ORG_ID=9089d4ad-f46c-405b-9798-6751d45a7051  # required when funnel enabled
#   PUBLIC_ESTIMATE_TURNSTILE_ON_PREVIEW=false   # defaults ON when funnel enabled
#   PUBLIC_ESTIMATE_TURNSTILE_SITE_KEY=...       # alias for TURNSTILE_SITE_KEY
#   VITE_TURNSTILE_SITE_KEY=...                 # legacy alias (already used on CRM Vercel)
#
# Website (arx-website / Next.js — holds NO Turnstile keys in production):
#   NEXT_PUBLIC_CRM_PUBLIC_ESTIMATE_URL=https://arx-internal-crm.vercel.app  # optional; this is the default
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # leave EMPTY in Vercel; local-dev fallback only
#
# Storm opportunity alerts cron (Inside Sales):
#   STORM_OPPORTUNITY_ALERTS_ENABLED=true
#   STORM_ALERT_EMAIL_TO=Nathan@arxroofing.com
