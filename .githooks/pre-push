#!/usr/bin/env bash
# Refuses a push unless scripts/gates.sh passed on the exact commit being pushed (one stamp per commit, so branches and worktrees
# do not invalidate each other). git push --no-verify skips this; don't. Enable once per clone: git config core.hooksPath .githooks
STAMP_DIR="$(git rev-parse --git-common-dir)/arx-gates-passed"
ZERO="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # deleting a ref
  # An annotated tag points at a tag object; check the commit it points to.
  commit="$(git rev-parse "$local_sha^{commit}" 2>/dev/null || echo "$local_sha")"
  if [ ! -f "$STAMP_DIR/$commit" ]; then
    echo "pre-push: refusing to push $local_ref ($commit)." >&2
    echo "pre-push: the gates have not passed on that exact commit. Run:  npm run gates" >&2
    exit 1
  fi
done
exit 0
